{
  "protocol_version": "2.0",
  "seed_pool": [42, 101, 202, 303, 404],
  "dataset": {
    "name": "Nkhotakota Primate Dataset",
    "location": "Nkhotakota Wildlife Reserve, Malawi",
    "total_frames_indexed": 40743,
    "total_frames_on_disk": 39386,
    "total_camera_stations": 49,
    "target_classes": ["primate"],
    "species_aggregated": ["yellow_baboon", "vervet_monkey", "blue_monkey", "lesser_bushbaby"],
    "license": "CDLA-Permissive-1.0 (LILA BC)",
    "split_strategy": "location_disjoint",
    "splits": {
      "train": {
        "num_stations": 35,
        "num_frames": 30620
      },
      "val": {
        "num_stations": 7,
        "num_frames": 5560,
        "stations": ["E13", "I14", "K15", "L21", "N16", "P20", "P26"]
      },
      "sealed_test": {
        "num_stations": 7,
        "num_frames": 3206,
        "stations": ["G25", "J21", "M22", "O03", "O12", "O14", "R27"]
      }
    }
  },
  "detector": {
    "architecture": "YOLO11n-F16",
    "base_model": "yolo11n.pt",
    "total_parameters": 2483792,
    "gflops": 6.4,
    "input_resolution": [640, 640],
    "hardware_profile": {
      "device": "NVIDIA A40 GPU",
      "framework": "FP16 TensorRT / Torch",
      "batch_size": 1,
      "mean_latency_ms": 10.99,
      "fps": 91.0,
      "peak_memory_mb": 480
    },
    "spline_bottleneck": {
      "type": "C3k2_FixedFastKAN",
      "feature_scale": "P5",
      "basis_type": "Gaussian_RBF",
      "grid_size_K": 16,
      "grid_range": [-1.0, 1.0],
      "trainable_coefficients": true,
      "trainable_grid_centres": false,
      "residual_base": "SiLU"
    }
  },
  "training": {
    "optimizer": "SGD",
    "momentum": 0.937,
    "weight_decay": 0.0005,
    "base_learning_rate": 0.01,
    "final_learning_rate_ratio": 0.01,
    "lr_scheduler": "cosine_annealing",
    "warmup_epochs": 3.0,
    "epochs_per_cycle": 20,
    "batch_size": 16,
    "workers": 8,
    "amp": true,
    "loss_gains": {
      "box": 7.5,
      "cls": 0.5,
      "dfl": 1.5,
      "label_smoothing": 0.0
    },
    "augmentation": {
      "mosaic_prob": 1.0,
      "close_mosaic_epochs": 10,
      "horizontal_flip": 0.5,
      "hsv_h": 0.015,
      "hsv_s": 0.7,
      "hsv_v": 0.4,
      "degrees_rotation": 0.0
    }
  },
  "active_learning": {
    "num_cycles": 5,
    "budget_schedule": [300, 450, 600, 750, 900],
    "initial_seed_budget": 300,
    "step_budget_delta": 150,
    "weight_transfer_across_cycles": false,
    "decontamination_checkpoint": "yolo11n.pt (COCO-80 pretrained, zero wildlife pre-exposure)",
    "policy_formula": "V(x_i | S) = [U(x_i) + lambda_d * D(x_i | L union S) + lambda_s * S(x_i)] / (C_annot(x_i) + epsilon) - lambda_r * R(x_i | S)",
    "policy_coefficients": {
      "lambda_d_diversity": 0.5,
      "lambda_s_site_novelty": 0.3,
      "lambda_r_burst_redundancy": 0.8,
      "burst_event_quota_Qmax": 3
    },
    "uncertainty_estimation": {
      "method": "MC_Dropout",
      "stochastic_passes": 5,
      "dropout_rate": 0.1,
      "components": ["classification_entropy", "iou_localization_variance"],
      "lambda_loc": 0.5
    },
    "diversity_estimation": {
      "feature_source": "FastKAN_P5_Bottleneck_256D",
      "feature_dim": 256,
      "distance_metric": "cosine_distance",
      "selection_algorithm": "submodular_k_center_facility_location"
    },
    "cost_model": {
      "formula": "C_annot(x_i) = c0 + c1 * N_boxes + c2 * mean_pairwise_iou",
      "c0_inspection_floor": 1.0,
      "c1_per_box_cost": 0.5,
      "c2_crowding_penalty": 0.25
    }
  },
  "evaluation": {
    "confidence_threshold": 0.25,
    "nms_iou_threshold": 0.45,
    "primary_metric": "mAP50_95",
    "secondary_metrics": ["mAP50", "precision", "recall", "AUBC50_95", "cumulative_boxes"]
  }
}
